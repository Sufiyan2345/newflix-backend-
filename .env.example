# ================= STREAMFLIX BACKEND ENV =================
# Copy this file to .env and fill in your real values

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# MongoDB (your Atlas cluster) — replace the placeholders with your own values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/netflixclone?retryWrites=true&w=majority

# JWT (generate long random strings, e.g. via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Frontend / Admin URLs (CORS whitelist)
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# TMDB API v4 read access token (kept server-side; never put this in frontend env)
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token
TMDB_API_KEY=your_tmdb_v3_api_key
# Optional provider template for TMDB series episodes. Placeholders: {tmdbId} {season} {episode}.
# Leave unset to use the built-in embeddable default, or point it at your licensed source.
TMDB_TV_SOURCE_TEMPLATE=https://vidsrc.su/embed/tv/{tmdbId}/{season}/{episode}
# Optional provider template for TMDB movies (a movie is one item, no season/episode).
# Placeholder: {tmdbId}. A TMDB movie mapped to a local title with a direct video URL
# always wins over this template, so licensed sources take priority.
TMDB_MOVIE_SOURCE_TEMPLATE=https://vidsrc.su/embed/movie/{tmdbId}

# Cloudinary (console.cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP for OTP emails (Google Account -> Security -> 2-Step Verification ON -> App Passwords)
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=Newflix

# Beem Africa SMS OTP (never expose these values to the frontend)
# Use the API key, secret key and approved sender ID from your Beem account.
SMS_PROVIDER=beem
BEEM_API_KEY=your_beem_api_key
BEEM_SECRET_KEY=your_beem_secret_key
BEEM_SENDER_ID=your_approved_beem_sender_id
# Optional alternative providers: SMS_PROVIDER=vonage or SMS_PROVIDER=wasender

# Super Admin bootstrap (created automatically on first server start)
SUPER_ADMIN_EMAIL=you@gmail.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

# Streaming security
SIGNED_URL_SECRET=change_this_signed_url_secret_too
SIGNED_URL_EXPIRES_MIN=120
